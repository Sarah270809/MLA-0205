        "import pandas as pd\n",
        "import math\n",
        "\n",
        "# ============================================================\n",
        "# DATASET\n",
        "# ============================================================\n",
        "\n",
        "data = [\n",
        "    [\"sunny\", \"hot\", \"high\", \"weak\", \"no\"],\n",
        "    [\"sunny\", \"hot\", \"high\", \"strong\", \"no\"],\n",
        "    [\"overcast\", \"hot\", \"high\", \"weak\", \"yes\"],\n",
        "    [\"rain\", \"mild\", \"high\", \"weak\", \"yes\"],\n",
        "    [\"rain\", \"cool\", \"normal\", \"weak\", \"yes\"],\n",
        "    [\"rain\", \"cool\", \"normal\", \"strong\", \"no\"],\n",
        "    [\"overcast\", \"cool\", \"normal\", \"strong\", \"yes\"],\n",
        "    [\"sunny\", \"mild\", \"high\", \"weak\", \"no\"],\n",
        "    [\"sunny\", \"cool\", \"normal\", \"weak\", \"yes\"],\n",
        "    [\"rain\", \"mild\", \"normal\", \"weak\", \"yes\"],\n",
        "    [\"sunny\", \"mild\", \"normal\", \"strong\", \"yes\"],\n",
        "    [\"overcast\", \"mild\", \"high\", \"strong\", \"yes\"],\n",
        "    [\"overcast\", \"hot\", \"normal\", \"weak\", \"yes\"],\n",
        "    [\"rain\", \"mild\", \"high\", \"strong\", \"no\"]\n",
        "]\n",
        "\n",
        "columns = [\"Outlook\", \"Temperature\", \"Humidity\", \"Wind\", \"Target\"]\n",
        "\n",
        "df = pd.DataFrame(data, columns=columns)\n",
        "\n",
        "print(\"========== DATASET ==========\")\n",
        "print(df.to_string(index=False))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ENTROPY\n",
        "# ============================================================\n",
        "\n",
        "def entropy(target):\n",
        "    values = target.value_counts()\n",
        "    total = len(target)\n",
        "\n",
        "    result = 0\n",
        "\n",
        "    for count in values:\n",
        "        probability = count / total\n",
        "        result -= probability * math.log2(probability)\n",
        "\n",
        "    return result\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# INFORMATION GAIN\n",
        "# ============================================================\n",
        "\n",
        "def information_gain(df, attribute, target=\"Target\"):\n",
        "\n",
        "    total_entropy = entropy(df[target])\n",
        "\n",
        "    weighted_entropy = 0\n",
        "\n",
        "    for value in df[attribute].unique():\n",
        "\n",
        "        subset = df[df[attribute] == value]\n",
        "\n",
        "        weighted_entropy += (\n",
        "            len(subset) / len(df)\n",
        "        ) * entropy(subset[target])\n",
        "\n",
        "    return total_entropy - weighted_entropy\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# FIND BEST ATTRIBUTE\n",
        "# ============================================================\n",
        "\n",
        "def best_attribute(df, attributes):\n",
        "\n",
        "    gains = {}\n",
        "\n",
        "    for attribute in attributes:\n",
        "        gains[attribute] = information_gain(df, attribute)\n",
        "\n",
        "    return max(gains, key=gains.get)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ID3 ALGORITHM\n",
        "# ============================================================\n",
        "\n",
        "def id3(df, attributes):\n",
        "\n",
        "    # If all target values are same\n",
        "    if len(df[\"Target\"].unique()) == 1:\n",
        "        return df[\"Target\"].iloc[0]\n",
        "\n",
        "    # If no attributes remain\n",
        "    if len(attributes) == 0:\n",
        "        return df[\"Target\"].mode()[0]\n",
        "\n",
        "    best = best_attribute(df, attributes)\n",
        "\n",
        "    tree = {best: {}}\n",
        "\n",
        "    remaining_attributes = [\n",
        "        attribute for attribute in attributes\n",
        "        if attribute != best\n",
        "    ]\n",
        "\n",
        "    for value in df[best].unique():\n",
        "\n",
        "        subset = df[df[best] == value]\n",
        "\n",
        "        tree[best][value] = id3(\n",
        "            subset,\n",
        "            remaining_attributes\n",
        "        )\n",
        "\n",
        "    return tree\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# BUILD TREE\n",
        "# ============================================================\n",
        "\n",
        "attributes = [\n",
        "    \"Outlook\",\n",
        "    \"Temperature\",\n",
        "    \"Humidity\",\n",
        "    \"Wind\"\n",
        "]\n",
        "\n",
        "tree = id3(df, attributes)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# PRINT TREE IN SIMPLE FORMAT\n",
        "# ============================================================\n",
        "\n",
        "def print_tree(tree, level=0):\n",
        "\n",
        "    if not isinstance(tree, dict):\n",
        "        print(\"    \" * level + \"→ \" + str(tree).upper())\n",
        "        return\n",
        "\n",
        "    attribute = list(tree.keys())[0]\n",
        "\n",
        "    for value, branch in tree[attribute].items():\n",
        "\n",
        "        print(\"    \" * level + attribute + \" = \" + value)\n",
        "\n",
        "        if isinstance(branch, dict):\n",
        "            print_tree(branch, level + 1)\n",
        "\n",
        "        else:\n",
        "            print(\"    \" * (level + 1) + \"→ \" + str(branch).upper())\n",
        "\n",
        "\n",
        "print(\"\\n========== DECISION TREE ==========\")\n",
        "print_tree(tree)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# TREE RULES\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n========== TREE RULES ==========\")\n",
        "\n",
        "print(\"1. If Outlook = Overcast → Target = Yes\")\n",
        "print(\"2. If Outlook = Sunny and Humidity = High → Target = No\")\n",
        "print(\"3. If Outlook = Sunny and Humidity = Normal → Target = Yes\")\n",
        "print(\"4. If Outlook = Rain and Wind = Weak → Target = Yes\")\n",
        "print(\"5. If Outlook = Rain and Wind = Strong → Target = No\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# INFORMATION GAIN\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n========== INFORMATION GAIN ==========\")\n",
        "\n",
        "for attribute in attributes:\n",
        "    gain = information_gain(df, attribute)\n",
        "    print(attribute, \"=\", round(gain, 4))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# CLASSIFY A NEW SAMPLE\n",
        "# ============================================================\n",
        "\n",
        "def predict(tree, sample):\n",
        "\n",
        "    if not isinstance(tree, dict):\n",
        "        return tree\n",
        "\n",
        "    attribute = list(tree.keys())[0]\n",
        "\n",
        "    value = sample[attribute]\n",
        "\n",
        "    branch = tree[attribute][value]\n",
        "\n",
        "    return predict(branch, sample)\n",
        "\n",
        "\n",
        "new_sample = {\n",
        "    \"Outlook\": \"sunny\",\n",
        "    \"Temperature\": \"cool\",\n",
        "    \"Humidity\": \"high\",\n",
        "    \"Wind\": \"strong\"\n",
        "}\n",
        "\n",
        "prediction = predict(tree, new_sample)\n",
        "\n",
        "print(\"\\n========== NEW SAMPLE ==========\")\n",
        "\n",
        "print(\"Outlook     =\", new_sample[\"Outlook\"])\n",
        "print(\"Temperature =\", new_sample[\"Temperature\"])\n",
        "print(\"Humidity    =\", new_sample[\"Humidity\"])\n",
        "print(\"Wind        =\", new_sample[\"Wind\"])\n",
        "\n",
        "print(\"\\nPredicted Target =\", prediction.upper())"
      ]
    }
